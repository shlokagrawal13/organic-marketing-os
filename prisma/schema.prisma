generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  CREATOR
  ANALYST
  CLIENT
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String
  passwordHash String
  verifiedAt   DateTime?
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sessions     Session[]
  tokens       AuthToken[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuthToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  purpose   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Organization {
  id                  String               @id @default(uuid())
  name                String
  timezone            String               @default("Asia/Kolkata")
  createdAt           DateTime             @default(now())
  memberships         Membership[]
  invitations         Invitation[]
  audits              AuditLog[]
  brand               BrandBrain?
  brandVersions       BrandVersion[]
  jobs                AIJob[]
  aiUsage             AIUsage[]
  agentRuns           AIAgentRun[]
  campaigns           Campaign[]
  content             ContentItem[]
  assets              Asset[]
  renders             RenderJob[]
  renderSegments      RenderSegment[]
  creditAccount       CreditAccount?
  creditEntries       CreditEntry[]
  creditReservations  CreditReservation[]
  billingSubscription BillingSubscription?
  billingEvents       BillingEvent[]
  billingInvoices     BillingInvoice[]
  mediaGenerations    MediaGeneration[]
  publicationIntents  PublicationIntent[]
  socialConnections   SocialConnection[]
  publicationAttempts PublicationAttempt[]
  publicationPolicyReviews PublicationPolicyReview[]
}

enum ContentStatus {
  DRAFT
  REVIEW
  APPROVED
  ARCHIVED
}

model Campaign {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  goal           String
  audience       String
  description    String        @default("")
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime      @default(now())
  content        ContentItem[]

  @@index([organizationId])
}

model ContentItem {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  title          String
  platform       String
  format         String
  hook           String           @default("")
  body           String           @default("")
  cta            String           @default("")
  scenes         Json             @default("[]")
  status         ContentStatus    @default(DRAFT)
  revision       Int              @default(1)
  plannedAt      DateTime?
  approvedAt     DateTime?
  approvedBy     String?
  createdBy      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  versions       ContentVersion[]
  comments       ContentComment[]
  renders        RenderJob[]
  publicationIntents PublicationIntent[]

  @@index([organizationId, status])
  @@index([organizationId, plannedAt])
}

model ContentVersion {
  id        String      @id @default(uuid())
  contentId String
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  revision  Int
  snapshot  Json
  actorId   String
  createdAt DateTime    @default(now())

  @@unique([contentId, revision])
}

model ContentComment {
  id         String      @id @default(uuid())
  contentId  String
  content    ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  actorId    String
  authorName String
  text       String
  sceneId    String?
  createdAt  DateTime    @default(now())

  @@index([contentId, createdAt])
}

enum PublicationIntentStatus {
  PREPARED
  INVALIDATED
  CANCELED
}

// Preparation is internal only. No provider call, scheduled job or posted state exists.
model PublicationIntent {
  id              String                  @id @default(uuid())
  organizationId  String
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentId       String
  content         ContentItem             @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentRevision Int
  renderId        String?
  platform        String
  snapshot        Json
  requestKey      String
  requestHash     String
  status          PublicationIntentStatus @default(PREPARED)
  createdBy       String
  createdAt       DateTime                @default(now())
  invalidatedAt   DateTime?
  canceledAt      DateTime?
  attempt         PublicationAttempt?
  policyReview    PublicationPolicyReview?

  @@unique([organizationId, requestKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, contentId, status])
}

enum SocialProvider {
  YOUTUBE
}

model SocialConnection {
  id                     String               @id @default(uuid())
  organizationId         String
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider               SocialProvider
  externalAccountId      String
  accountLabel           String
  scopes                 String[]
  accessTokenCiphertext  String
  refreshTokenCiphertext String?
  tokenExpiresAt         DateTime?
  refreshTokenExpiresAt  DateTime?
  refreshPendingAt       DateTime?
  revokedAt              DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  attempts               PublicationAttempt[]
  policyReviews          PublicationPolicyReview[]

  @@unique([organizationId, provider, externalAccountId])
  @@index([organizationId, revokedAt])
}

enum PublicationAttemptStatus {
  RESERVED
  SUBMITTING
  UNKNOWN
  CONFIRMED
  REJECTED
  BLOCKED
}

// Only an authorized provider adapter may create a connection and enter SUBMITTING.
// OAuth connection and token lifecycle routes exist; dispatch and provider posting are not wired.
model PublicationAttempt {
  id                String                   @id @default(uuid())
  organizationId    String
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intentId          String                   @unique
  intent            PublicationIntent        @relation(fields: [intentId], references: [id], onDelete: Cascade)
  connectionId      String
  connection        SocialConnection         @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  contentId         String
  contentRevision   Int
  requestKey        String
  requestHash       String
  status            PublicationAttemptStatus @default(RESERVED)
  version           Int                      @default(1)
  providerRequestId String?
  providerPostId    String?
  outcomeCode       String?
  policySnapshot    Json?
  createdAt         DateTime                 @default(now())
  startedAt         DateTime?
  completedAt       DateTime?

  @@unique([organizationId, requestKey])
  @@index([organizationId, contentId, contentRevision, status])
  @@index([status, startedAt])
}

model PublicationPolicyReview {
  id                String            @id @default(uuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intentId          String            @unique
  intent            PublicationIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  connectionId      String
  connection        SocialConnection  @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  contentRevision   Int
  policyVersion     String
  metadata          Json
  snapshotHash      String
  reviewedBy        String
  reviewedAt        DateTime          @default(now())
  expiresAt         DateTime

  @@index([organizationId, expiresAt])
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum AgentRunStatus {
  RUNNING
  AWAITING_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum AgentStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  BLOCKED
  WAITING
  APPROVED
  REJECTED
  FAILED
}

model AIJob {
  id                  String             @id @default(uuid())
  organizationId      String
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId             String
  requestKey          String
  task                String
  input               Json
  output              Json?
  brandContext        Json?
  creditReservationId String?            @unique
  creditReservation   CreditReservation? @relation(fields: [creditReservationId], references: [id], onDelete: Restrict)
  runToken            String?
  heartbeatAt         DateTime?
  status              JobStatus          @default(QUEUED)
  attempts            Int                @default(0)
  error               String?
  dispatchedAt        DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime           @default(now())
  usage               AIUsage[]
  agentRun            AIAgentRun?

  @@unique([organizationId, requestKey])
  @@index([status, dispatchedAt])
  @@index([status, heartbeatAt])
  @@index([organizationId, createdAt])
}

model AIUsage {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId             String
  job               AIJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agentStepId       String?
  agentStep         AIAgentStep? @relation(fields: [agentStepId], references: [id], onDelete: SetNull)
  provider          String
  model             String
  inputTokens       Int?
  outputTokens      Int?
  estimatedCostUsd  Float?
  latencyMs         Int
  success           Boolean
  fallback          Boolean      @default(false)
  retryCount        Int          @default(0)
  qualityTier       String       @default("standard")
  failureCode       String?
  providerRequestId String?
  unknownOutcome    Boolean      @default(false)
  routingMetadata   Json         @default("{}")
  createdAt         DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([agentStepId])
}

model AIAgentRun {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String         @unique
  job            AIJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  graphVersion   String
  task           String
  frozenContext  Json
  state          AgentRunStatus @default(RUNNING)
  finalReview    Json?
  reviewedBy     String?
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?
  steps          AIAgentStep[]

  @@index([organizationId, createdAt])
  @@index([state, createdAt])
}

model AIAgentStep {
  id             String          @id @default(uuid())
  runId          String
  run            AIAgentRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  key            String
  sequence       Int
  role           String
  kind           String
  responsibility String
  dependencies   Json
  state          AgentStepStatus @default(PENDING)
  inputContext   Json
  output         Json?
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  usage          AIUsage[]

  @@unique([runId, key])
  @@index([runId, sequence])
  @@index([state, startedAt])
}

model BrandBrain {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Json
  creativeDna    Json
  revision       Int          @default(1)
  updatedAt      DateTime     @updatedAt
}

model BrandVersion {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Json
  creativeDna    Json
  revision       Int
  actorId        String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, revision])
}

model Membership {
  userId         String
  organizationId String
  role           Role         @default(CREATOR)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role
  tokenHash      String       @unique
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@unique([organizationId, email])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String
  action         String
  entityId       String?
  detail         Json         @default("{}")
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
}

model Asset {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  kind           AssetKind
  mimeType       String
  bytes          Int
  sha256         String
  objectKey      String            @unique
  width          Int?
  height         Int?
  duration       Float?
  tags           String[]          @default([])
  rightsNote     String            @default("")
  createdBy      String
  createdAt      DateTime          @default(now())
  archivedAt     DateTime?
  renderInputs   RenderInput[]
  generations    MediaGeneration[]

  @@unique([organizationId, sha256])
  @@index([organizationId, createdAt])
}

model RenderJob {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentId       String
  content         ContentItem   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentRevision Int
  actorId         String
  requestKey      String
  requestHash     String
  snapshot        Json
  options         Json
  status          JobStatus     @default(QUEUED)
  progress        Int           @default(0)
  stage           String        @default("Waiting for render worker")
  reusedScenes    Int           @default(0)
  totalScenes     Int
  runToken        String?
  heartbeatAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  error           String?
  outputKey       String?
  thumbnailKey    String?
  captionsKey     String?
  outputBytes     Int?
  width           Int?
  height          Int?
  duration        Float?
  approvedAt      DateTime?
  approvedBy      String?
  inputs          RenderInput[]

  @@unique([organizationId, requestKey])
  @@index([organizationId, createdAt])
  @@index([status, heartbeatAt])
}

model RenderInput {
  renderId String
  render   RenderJob @relation(fields: [renderId], references: [id], onDelete: Cascade)
  assetId  String
  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([renderId, assetId])
}

model RenderSegment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cacheKey       String
  objectKey      String
  bytes          Int
  createdAt      DateTime     @default(now())

  @@unique([organizationId, cacheKey])
}

model CreditAccount {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  available      Int          @default(0)
  reserved       Int          @default(0)
  revision       Int          @default(0)
  updatedAt      DateTime     @updatedAt
}

model CreditEntry {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  operationKey   String
  requestHash    String
  kind           String
  availableDelta Int
  reservedDelta  Int
  availableAfter Int
  reservedAfter  Int
  sequence       Int
  reference      String
  reason         String
  actorId        String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, operationKey])
  @@unique([organizationId, sequence])
  @@index([organizationId, createdAt])
}

model CreditReservation {
  id              String           @id @default(uuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reference       String
  credits         Int
  consumed        Int              @default(0)
  state           String           @default("RESERVED")
  createdAt       DateTime         @default(now())
  resolvedAt      DateTime?
  job             AIJob?
  mediaGeneration MediaGeneration?

  @@unique([organizationId, reference])
  @@index([organizationId, state])
}

model BillingPlan {
  id             String                @id
  name           String
  active         Boolean               @default(true)
  monthlyCredits Int                   @default(0)
  entitlements   Json                  @default("{}")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  subscriptions  BillingSubscription[]
}

model BillingSubscription {
  id                     String           @id @default(uuid())
  organizationId         String           @unique
  organization           Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  planId                 String
  plan                   BillingPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  provider               String
  externalCustomerId     String?
  externalSubscriptionId String?          @unique
  status                 String
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean          @default(false)
  lastEventCreatedAt     DateTime?
  lastEventId            String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  invoices               BillingInvoice[]

  @@index([planId, status])
}

model BillingEvent {
  id                String          @id @default(uuid())
  provider          String
  externalId        String
  type              String
  organizationId    String?
  organization      Organization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  providerCreatedAt DateTime
  payload           Json
  payloadHash       String
  status            String          @default("RECEIVED")
  applied           Boolean         @default(false)
  error             String?
  receivedAt        DateTime        @default(now())
  processedAt       DateTime?
  invoice           BillingInvoice?

  @@unique([provider, externalId])
  @@index([status, receivedAt])
  @@index([organizationId, receivedAt])
}

model BillingInvoice {
  id                     String               @id @default(uuid())
  organizationId         String
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscriptionId         String?
  subscription           BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  billingEventId         String               @unique
  billingEvent           BillingEvent         @relation(fields: [billingEventId], references: [id], onDelete: Restrict)
  provider               String
  externalInvoiceId      String?
  externalSubscriptionId String?
  status                 String
  currency               String?
  amountDue              Int?
  amountPaid             Int?
  hostedInvoiceUrl       String?
  invoicePdfUrl          String?
  periodStart            DateTime
  periodEnd              DateTime
  creditsGranted         Int                  @default(0)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@unique([provider, externalInvoiceId])
  @@index([organizationId, periodEnd])
  @@index([subscriptionId, periodEnd])
}

enum MediaGenerationState {
  QUEUED
  SUBMITTING
  PENDING
  OUTPUT_READY
  SUCCEEDED
  FAILED
  CANCELED
  UNKNOWN
}

model MediaGeneration {
  id                      String               @id @default(uuid())
  organizationId          String
  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId                 String
  requestKey              String
  requestHash             String
  request                 Json
  configuration           Json
  state                   MediaGenerationState @default(QUEUED)
  providerJobId           String?
  providerRequestId       String?
  outputKey               String?
  assetId                 String?
  asset                   Asset?               @relation(fields: [assetId], references: [id], onDelete: Restrict)
  creditReservationId     String?              @unique
  creditReservation       CreditReservation?   @relation(fields: [creditReservationId], references: [id], onDelete: Restrict)
  quotedCostUsd           Float
  quotedCredits           Int
  actualCostUsd           Float?
  runToken                String?
  heartbeatAt             DateTime?
  nextAttemptAt           DateTime             @default(now())
  cancellationRequestedAt DateTime?
  attachedRevision        Int?
  error                   String?
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@unique([organizationId, requestKey])
  @@index([organizationId, createdAt])
  @@index([state, nextAttemptAt])
  @@index([state, heartbeatAt])
}
