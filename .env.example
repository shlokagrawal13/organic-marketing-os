# Run npm run setup to generate local secrets. Never commit .env.
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
API_PORT=4000
# Optional trusted render-worker font. Blank uses system DejaVu Sans.
# Single TTF/OTF only, at most 16 MiB; mounted inside the worker if containerized.
RENDER_FONT_PATH=
# Trusted fallback TTF/OTF paths, separated by the OS path delimiter.
RENDER_FONT_FALLBACK_PATHS=
# Opt in only with a covering Devanagari font and FFmpeg with the librsvg SVG decoder.
RENDER_DEVANAGARI_ENABLED=false
# Separate opt-in; requires a trusted Bengali font and the same librsvg decoder.
RENDER_BENGALI_ENABLED=false
# Separate opt-in; requires a trusted Gujarati font and the same librsvg decoder.
RENDER_GUJARATI_ENABLED=false
# Independent Indic batch opt-ins require covering fonts and the same librsvg decoder.
RENDER_GURMUKHI_ENABLED=false
RENDER_ODIA_ENABLED=false
RENDER_TAMIL_ENABLED=false
RENDER_TELUGU_ENABLED=false
RENDER_KANNADA_ENABLED=false
RENDER_MALAYALAM_ENABLED=false
RENDER_SINHALA_ENABLED=false
RENDER_THAI_ENABLED=false
RENDER_LAO_ENABLED=false
RENDER_KHMER_ENABLED=false
RENDER_MYANMAR_ENABLED=false
RENDER_TIBETAN_ENABLED=false
# Independent CJK opt-ins need covering single OTF/TTF fonts and librsvg.
# Select cjkLanguage in each render; collections/web fonts stay unsupported.
RENDER_HAN_ENABLED=false
RENDER_HIRAGANA_ENABLED=false
RENDER_KATAKANA_ENABLED=false
RENDER_HANGUL_ENABLED=false
POSTGRES_PASSWORD=GENERATE_WITH_SETUP
DATABASE_URL=postgresql://marketing:GENERATE_WITH_SETUP@localhost:5432/marketing?schema=public
REDIS_URL=redis://localhost:6379
ENCRYPTION_KEY=GENERATE_WITH_SETUP
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Marketing OS <hello@localhost>
AI_PRIMARY_KEY=
AI_PRIMARY_URL=https://api.openai.com/v1
AI_PRIMARY_MODEL=
AI_PRIMARY_QUALITY=
AI_PRIMARY_CAPABILITIES=text,json,strategy,content,scene
AI_PRIMARY_PLANS=free,starter,growth,self_hosted
AI_PRIMARY_PRIORITY=10
AI_PRIMARY_INPUT_USD_PER_MILLION=
AI_PRIMARY_OUTPUT_USD_PER_MILLION=
AI_FALLBACK_KEY=
AI_FALLBACK_URL=
AI_FALLBACK_MODEL=
AI_FALLBACK_QUALITY=
AI_FALLBACK_CAPABILITIES=text,json,strategy,content,scene
AI_FALLBACK_PLANS=free,starter,growth,self_hosted
AI_FALLBACK_PRIORITY=20
AI_FALLBACK_INPUT_USD_PER_MILLION=
AI_FALLBACK_OUTPUT_USD_PER_MILLION=
# A configured cap requires both input/output prices; unknown-cost routes are blocked.
AI_MAX_REQUEST_USD=
# self_hosted bills the configured provider directly. credits enforces the ledger.
BILLING_MODE=self_hosted
# At least 32 random characters. Required only for the signed test webhook.
BILLING_WEBHOOK_SECRET=GENERATE_WITH_SETUP
# disabled, test or live. Test/live require all four Stripe values below.
STRIPE_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
AI_STRATEGY_CREDITS=5
AI_CONTENT_CREDITS=3
AI_SCENE_CREDITS=1
# Comma-separated existing user UUIDs; their email must also be verified.
PLATFORM_ADMIN_USER_IDS=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=marketing-assets
S3_ACCESS_KEY=marketing
S3_SECRET_KEY=GENERATE_WITH_SETUP
S3_AUTO_CREATE_BUCKET=false
S3_FORCE_PATH_STYLE=true

# Generated media is opt-in. Choose models that support the fixed presets in
# docs/GENERATED_MEDIA.md. No paid calls or runtime fixtures are enabled by default.
MEDIA_GENERATION_ENABLED=false
OPENAI_MEDIA_API_KEY=
# Use current provider prices to set conservative per-request estimates; these
# are operator estimates, NOT provider-enforced USD caps. No default prices.
MEDIA_IMAGE_MODEL=
MEDIA_IMAGE_ESTIMATE_USD=
MEDIA_IMAGE_CREDITS=
# Optional comma-separated plan allowlist for this media kind.
# Allowed: free,starter,growth,self_hosted. Blank means all plans.
MEDIA_IMAGE_PLANS=
# Optional single owned-image edit preset. Set both values to enable it;
# quote it separately because reference input can change provider cost.
MEDIA_IMAGE_EDIT_ESTIMATE_USD=
MEDIA_IMAGE_EDIT_CREDITS=
MEDIA_VIDEO_MODEL=
MEDIA_VIDEO_ESTIMATE_USD=
MEDIA_VIDEO_CREDITS=
MEDIA_VIDEO_PLANS=
MEDIA_VOICE_MODEL=
MEDIA_VOICE_ESTIMATE_USD=
MEDIA_VOICE_CREDITS=
MEDIA_VOICE_PLANS=

# SOCIAL-01 future OAuth adapter only. Generate a separate 32-byte random key,
# encode it as canonical base64, and supply it through secret configuration.
# Local preparation and attempt-ledger tests do not require a runtime key.
SOCIAL_TOKEN_ENCRYPTION_KEY=
