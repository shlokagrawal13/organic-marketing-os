# Run npm run setup to generate local secrets. Never commit .env.
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
API_PORT=4000
POSTGRES_PASSWORD=GENERATE_WITH_SETUP
DATABASE_URL=postgresql://marketing:GENERATE_WITH_SETUP@localhost:5432/marketing?schema=public
REDIS_URL=redis://localhost:6379
ENCRYPTION_KEY=GENERATE_WITH_SETUP
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Marketing OS <hello@localhost>
AI_PRIMARY_KEY=
AI_PRIMARY_URL=https://api.openai.com/v1
AI_PRIMARY_MODEL=
AI_FALLBACK_KEY=
AI_FALLBACK_URL=
AI_FALLBACK_MODEL=
# self_hosted bills the configured provider directly. credits enforces the ledger.
BILLING_MODE=self_hosted
# At least 32 random characters. Required only for the signed test webhook.
BILLING_WEBHOOK_SECRET=GENERATE_WITH_SETUP
AI_STRATEGY_CREDITS=5
AI_CONTENT_CREDITS=3
AI_SCENE_CREDITS=1
# Comma-separated existing user UUIDs; their email must also be verified.
PLATFORM_ADMIN_USER_IDS=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=marketing-assets
S3_ACCESS_KEY=marketing
S3_SECRET_KEY=GENERATE_WITH_SETUP
S3_AUTO_CREATE_BUCKET=false
S3_FORCE_PATH_STYLE=true
