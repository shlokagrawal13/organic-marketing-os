{
  "name": "organic-marketing-os",
  "version": "0.9.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-fontkit.mjs",
    "dev:web": "next dev apps/web -H 0.0.0.0",
    "dev:api": "tsc -p apps/api/tsconfig.json && node --env-file=.env dist/apps/api/src/main.js",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:web": "next build apps/web",
    "build": "npm run db:generate && npm run build:api && npm run build:web",
    "start:api": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/api/src/worker.js",
    "start:web": "next start apps/web -H 0.0.0.0",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "node --import tsx --test --test-concurrency=2 --test-reporter=./scripts/unit-reporter.mjs tests/*.test.ts",
    "test:integration": "node --env-file=.env --import tsx --test tests/integration/*.test.ts",
    "test:ui": "playwright test",
    "setup": "node scripts/setup.mjs",
    "start:render": "node dist/apps/api/src/render-worker.js",
    "verify": "node scripts/verify-local.mjs --production-web",
    "verify:upgrade": "node scripts/verify-upgrade.mjs",
    "start:media": "node dist/apps/api/src/media-generation-worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "6.19.3",
    "bullmq": "^5.60.0",
    "cookie-parser": "^1.4.7",
    "fontkit": "2.0.4",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "linebreak": "1.1.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "nodemailer": "10.0.10",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "22.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "^1.58.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/fontkit": "2.0.9",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.8",
    "prisma": "6.19.3",
    "smtp-server": "^3.19.13",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "multer": "2.4.0",
    "deepmerge-ts": "8.0.0",
    "sharp": "0.35.5"
  }
}
