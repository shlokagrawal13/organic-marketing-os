{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "../../dist",
    "rootDir": "../..",
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "../../packages/**/*.ts"]
}
